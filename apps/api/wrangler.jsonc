{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aldergate",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "../web/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "plain-limit-d106.cloudflareaccess.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aldergate",
      "database_id": "1cc8439a-6f25-4bad-9e5b-3eba3d6f3353",
      "migrations_dir": "migrations"
    }
  ]
}
